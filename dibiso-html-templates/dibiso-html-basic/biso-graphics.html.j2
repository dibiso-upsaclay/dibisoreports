{#- Rendering of each BiSO graphic, with its own explanatory text, wherever the report layout places it.
    Imported "with context" by biso.html.j2. -#}

{#- Graphics shown with a "bêta" badge in their section title -#}
{% set beta_graphics = [] %}

{% macro graphic(key) -%}
{% if key == 'works_type' %}
  {{ figures.works_type | safe }}
  {% if workstype_info is defined and workstype_info %}<p class="dibiso-info">{{ workstype_info }}</p>{% endif %}

{% elif key == 'journals_hal' %}
  {{ figures.journals_hal | safe }}
